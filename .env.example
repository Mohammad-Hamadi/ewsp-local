# Compose project resources are scoped as ewsp-local_*.
COMPOSE_PROJECT_NAME=ewsp-local

# PostgreSQL - local development credentials only.
POSTGRES_DB=ewsp
POSTGRES_USER=ewsp_local
POSTGRES_PASSWORD=local-postgres-password-change-before-sharing
POSTGRES_HOST_PORT=5432

# Redis
REDIS_HOST_PORT=6379

# MinIO - local development credentials only.
MINIO_ROOT_USER=ewsp-local-minio
MINIO_ROOT_PASSWORD=local-minio-password-change-before-sharing
MINIO_BUCKET_NAME=ewsp-evidence
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# Backend
BACKEND_HOST_PORT=8080
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=local-jwt-secret-change-before-sharing
EWSP_CORS_ALLOWED_ORIGINS=http://localhost:3000
EWSP_MOBILE_LATEST_VERSION=1.0.1
EWSP_MOBILE_LATEST_VERSION_CODE=2
EWSP_MOBILE_UPDATE_URL=https://github.com/Mohammad-Hamadi/ewsp-mobile/releases/download/v1.0.1/ewsp-1.0.1.apk

# SMTP OTP delivery. Keep real credentials only in ignored .env or protected deployment.env.
EWSP_MAIL_ENABLED=false
EWSP_MAIL_HOST=smtp.example.com
EWSP_MAIL_PORT=587
EWSP_MAIL_USERNAME=
EWSP_MAIL_PASSWORD=
EWSP_MAIL_FROM=
EWSP_MAIL_SMTP_AUTH=true
EWSP_MAIL_STARTTLS_ENABLE=true

# Dashboard
DASHBOARD_HOST_PORT=3000

# Kubernetes application artifacts: replace placeholders with immutable 40-character CI Git SHA tags.
EWSP_BACKEND_IMAGE=ghcr.io/mohammad-hamadi/ewsp-backend:<full-git-sha>
EWSP_DASHBOARD_IMAGE=ghcr.io/mohammad-hamadi/ewsp-dashboard:<full-git-sha>

# Private GHCR pull credentials (local ignored .env only; token needs package read permission only).
GHCR_USERNAME=
GHCR_TOKEN=

# Permanent Cloudflare Tunnel (explicit opt-in; keep the real token only in ignored .env)
CLOUDFLARE_TUNNEL_ENABLED=false
CLOUDFLARE_TUNNEL_TOKEN=
# Safe, optional status/documentation value, for example: ewsp.example.com
CLOUDFLARE_PUBLIC_HOSTNAME=
