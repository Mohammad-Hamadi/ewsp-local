# Compose project resources are scoped as ewsp-local_*.
COMPOSE_PROJECT_NAME=ewsp-local

# PostgreSQL - local development credentials only.
POSTGRES_DB=ewsp
POSTGRES_USER=ewsp_local
POSTGRES_PASSWORD=local-postgres-password-change-before-sharing
POSTGRES_HOST_PORT=5432

# Redis
REDIS_HOST_PORT=6379

# MinIO - local development credentials only.
MINIO_ROOT_USER=ewsp-local-minio
MINIO_ROOT_PASSWORD=local-minio-password-change-before-sharing
MINIO_BUCKET_NAME=ewsp-evidence
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# Backend
BACKEND_HOST_PORT=8080
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=local-jwt-secret-change-before-sharing
EWSP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Dashboard. Vite embeds this value during docker compose build.
DASHBOARD_HOST_PORT=3000
VITE_API_BASE_URL=http://localhost:8080
