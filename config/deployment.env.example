# Copy only to %USERPROFILE%\.ewsp\deployment.env through the explicit
# `.\ewsp.ps1 deploy-configure` workflow. Never place real values in Git.
# Fine-grained: existing private Actions read grants plus ewsp-local Contents read/write.
EWSP_GITHUB_READ_TOKEN=
GHCR_USERNAME=
GHCR_TOKEN=
EWSP_ADMIN_EMAIL=admin@ewsp.local
EWSP_ADMIN_PASSWORD=
EWSP_MAIL_ENABLED=true
EWSP_MAIL_HOST=smtp.example.com
EWSP_MAIL_PORT=587
EWSP_MAIL_USERNAME=
EWSP_MAIL_PASSWORD=
EWSP_MAIL_FROM=
EWSP_MAIL_SMTP_AUTH=true
EWSP_MAIL_STARTTLS_ENABLE=true
DASHBOARD_HOST_PORT=3000
CLOUDFLARE_TUNNEL_ENABLED=false
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_PUBLIC_HOSTNAME=
